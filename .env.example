# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for auth redirect links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings -> API). Local `supabase start` prints these too.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres connection used by the Next.js server (Drizzle) and drizzle-kit.
# Hosted Supabase on Vercel: use the transaction pooler URL (port 6543).
# Local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
